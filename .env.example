# ============================================
# EdgeVoice Environment Configuration
# Phase 7.3: 환경 변수 예제 파일
# ============================================
#
# Copy this file to .env and configure your settings:
#   cp .env.example .env
#
# ============================================

# ============================================
# General Settings
# ============================================

# Environment: dev or jetson
ENVIRONMENT=dev

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Model cache path (where models are stored)
# Folder structure:
#   models/
#   ├── embedding/    # BGE-M3 embedding model
#   ├── llm/          # LLM models (Qwen, DeepSeek, Phi-4)
#   ├── stt/          # Speech-to-Text models (faster-whisper)
#   ├── tts/kokoro/   # TTS Kokoro model
#   └── wake_word/    # Wake word detection models
MODEL_CACHE_PATH=./models

# ============================================
# HuggingFace Configuration
# ============================================

# HuggingFace token (required for some models)
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ============================================
# STT Service (Faster-Whisper)
# ============================================

# Model size: tiny, base, small, medium, large-v2, large-v3, large-v3-turbo
# Dev: large-v3 (best quality)
# Jetson: small (balanced performance)
STT_MODEL_SIZE=large-v3

# Compute type: float16, int8, int8_float16
# Dev: float16 (best quality)
# Jetson: int8 (memory efficient)
STT_COMPUTE_TYPE=float16

# Language: ko, en, ja, zh, etc. (or auto for detection)
STT_LANGUAGE=ko

# ============================================
# LLM Service (vLLM)
# ============================================

# Model name from HuggingFace
# Dev: Qwen/Qwen2.5-72B-Instruct-AWQ (high quality)
# Jetson: Qwen/Qwen2.5-7B-Instruct-GPTQ-Int4 (memory efficient)
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct-AWQ

# Tensor parallel size (number of GPUs for model parallelism)
LLM_TENSOR_PARALLEL_SIZE=1

# GPU memory utilization (0.0-1.0)
# Dev: 0.9 (use most of GPU memory)
# Jetson: 0.8 (leave some for other services)
LLM_GPU_MEMORY_UTILIZATION=0.9

# Maximum model context length
# Dev: 8192 (longer context)
# Jetson: 2048 (memory limited)
LLM_MAX_MODEL_LEN=8192

# ============================================
# TTS Service
# ============================================

# TTS Engine: kokoro, edge-tts, piper
TTS_ENGINE=kokoro

# Model path (relative to container, mounted from models/tts/kokoro)
TTS_MODEL_PATH=/models/kokoro

# Voice ID (if multiple voices available)
TTS_VOICE=default

# ============================================
# Embedding Service (BGE)
# ============================================

# Model name
# Dev: BAAI/bge-m3 (multilingual, high quality)
# Jetson: BAAI/bge-small-en-v1.5 (memory efficient)
EMBEDDING_MODEL=BAAI/bge-m3

# ============================================
# Wake Word Service (OpenWakeWord)
# ============================================

# Detection threshold (0.0-1.0)
# Higher = fewer false positives, may miss some activations
WAKE_WORD_THRESHOLD=0.5

# Wake word model (hey_jarvis, alexa, etc.)
WAKE_WORD_MODEL=hey_jarvis

# ============================================
# RAG Service
# ============================================

# Vector database path
VECTOR_DB_PATH=/data/vectordb

# Number of documents to retrieve
RAG_TOP_K=5

# Similarity threshold
RAG_SIMILARITY_THRESHOLD=0.7

# ============================================
# Audio Gateway
# ============================================

# VAD (Voice Activity Detection) threshold
VAD_THRESHOLD=0.5

# Sample rate (Hz)
AUDIO_SAMPLE_RATE=16000

# Chunk duration (ms)
AUDIO_CHUNK_DURATION=100

# ============================================
# Backend Service
# ============================================

# Database URL (SQLite for simplicity)
DATABASE_URL=sqlite:///data/edgevoice.db

# Redis URL (for pub/sub and caching)
REDIS_URL=redis://redis:6379

# Session secret (change in production!)
SESSION_SECRET=change-this-in-production

# ============================================
# Service URLs (internal Docker network)
# ============================================

STT_SERVICE_URL=http://stt:8001
TTS_SERVICE_URL=http://tts:8002
LLM_SERVICE_URL=http://llm:8003
EMBEDDING_SERVICE_URL=http://embedding:8004
WAKE_WORD_SERVICE_URL=http://wake-word:8005
RAG_SERVICE_URL=http://rag:8006
ORCHESTRATOR_URL=http://orchestrator:8007
AUDIO_GATEWAY_URL=http://audio-gateway:8008

# ============================================
# NVIDIA GPU Settings
# ============================================

# Visible devices (comma-separated GPU indices)
NVIDIA_VISIBLE_DEVICES=all

# Driver capabilities
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ============================================
# Jetson-Specific Settings
# ============================================

# Power mode (for Jetson)
# 0: MAXN (maximum performance)
# 1: 15W (balanced)
# 2: 10W (power saving)
# JETSON_POWER_MODE=0

# JetPack version
# JETPACK_VERSION=5.1
