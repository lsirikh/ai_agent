{
  "servers": [
    {
      "name": "browser",
      "url": "http://host.docker.internal:8931/mcp",
      "allowed_tools": [
        "browser_navigate",
        "browser_navigate_back",
        "browser_snapshot",
        "browser_click",
        "browser_type",
        "browser_tabs",
        "browser_close"
      ],
      "trusted": true,
      "always_confirm": [
        "browser_click",
        "browser_type"
      ],
      "timeout": 60
    },
    {
      "name": "desktop",
      "url": "http://host.docker.internal:8932/mcp",
      "allowed_tools": [
        "open_app",
        "write_document",
        "list_test_files",
        "read_test_file"
      ],
      "trusted": true,
      "always_confirm": [],
      "timeout": 120
    }
  ]
}
