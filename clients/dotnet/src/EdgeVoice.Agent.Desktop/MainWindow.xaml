<Window x:Class="EdgeVoice.Agent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EdgeVoice Agent" Width="1000" Height="720">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Margin" Value="0,6,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <TabControl Margin="6">
        <!-- 대시보드 -->
        <TabItem Header="Dashboard" DataContext="{Binding Dashboard}">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="새로고침" Command="{Binding RefreshCommand}" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding SystemStatus}" FontWeight="Bold" />
                </StackPanel>
                <UniformGrid DockPanel.Dock="Top" Columns="4" Margin="0,0,0,10">
                    <StackPanel><TextBlock Text="Orchestrator" Style="{StaticResource Label}" /><TextBlock Text="{Binding OrchestratorState}" FontSize="18" /></StackPanel>
                    <StackPanel><TextBlock Text="GPU" Style="{StaticResource Label}" /><TextBlock Text="{Binding Gpu}" FontSize="18" /></StackPanel>
                    <StackPanel><TextBlock Text="Active Sessions" Style="{StaticResource Label}" /><TextBlock Text="{Binding Sessions}" FontSize="18" /></StackPanel>
                    <StackPanel><TextBlock Text="Documents" Style="{StaticResource Label}" /><TextBlock Text="{Binding Documents}" FontSize="18" /></StackPanel>
                </UniformGrid>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="Gray" />
                <DataGrid ItemsSource="{Binding Services}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Service" Binding="{Binding Name}" Width="200" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- 채팅 -->
        <TabItem Header="Chat" DataContext="{Binding Chat}">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="Gray" />
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,4">
                    <ToggleButton DockPanel.Dock="Left" Width="44" Margin="0,0,6,0" FontSize="16" Content="🎤"
                                  IsChecked="{Binding IsRecording, Mode=OneWay}" Command="{Binding ToggleMicCommand}"
                                  ToolTip="마이크 스트리밍 시작/중지" />
                    <CheckBox DockPanel.Dock="Right" Content="RAG" IsChecked="{Binding UseRag}" VerticalAlignment="Center" Margin="6,0,0,0" />
                    <Button DockPanel.Dock="Right" Content="전송" Command="{Binding SendCommand}" IsDefault="True" Margin="6,0,0,0" />
                    <TextBox Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" />
                </DockPanel>
                <ListBox ItemsSource="{Binding Messages}" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <TextBlock Text="{Binding Role}" FontWeight="Bold" />
                                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </TabItem>

        <!-- 지식 베이스 -->
        <TabItem Header="Knowledge" DataContext="{Binding Knowledge}">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="문서 업로드..." Command="{Binding UploadCommand}" />
                    <Button Content="새로고침" Command="{Binding RefreshCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="Gray" />
                <DataGrid x:Name="DocumentGrid" ItemsSource="{Binding Documents}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="파일" Binding="{Binding Filename}" Width="*" />
                        <DataGridTextColumn Header="정보" Binding="{Binding Meta}" Width="220" />
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="삭제" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.DeleteCommand, ElementName=DocumentGrid}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- 설정 -->
        <TabItem Header="Settings" DataContext="{Binding Settings}">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="Gray" />
                <ScrollViewer>
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left">
                        <TextBlock Text="모델" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="TTS Engine" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding TtsEngines}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding TtsEngine}" />
                        <TextBlock Text="TTS Voice" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding TtsVoices}" SelectedItem="{Binding TtsVoice}" />
                        <TextBlock Text="STT Model" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding SttModels}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding SttModel}" />
                        <TextBlock Text="LLM Model" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding LlmModels}" DisplayMemberPath="Label" SelectedValuePath="Id" SelectedValue="{Binding LlmModel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,16">
                            <Button Content="모델 적용" Command="{Binding ApplyModelsCommand}" />
                            <Button Content="LLM 재시작" Command="{Binding RestartLlmCommand}" />
                        </StackPanel>

                        <TextBlock Text="일반" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Wake Word" Style="{StaticResource Label}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="등록" Command="{Binding RegisterWakeWordCommand}" Margin="6,0,0,0" />
                            <ComboBox ItemsSource="{Binding WakeWords}" SelectedItem="{Binding WakeWord}" />
                        </DockPanel>
                        <TextBlock Text="Language" Style="{StaticResource Label}" />
                        <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" />
                        <TextBlock Style="{StaticResource Label}" Text="{Binding VoiceSpeed, StringFormat='Voice Speed: {0:0.0}x'}" />
                        <Slider Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding VoiceSpeed}" />
                        <TextBlock Style="{StaticResource Label}" Text="{Binding WakeWordThreshold, StringFormat='Wake Word Threshold: {0:0.00}'}" />
                        <Slider Minimum="0.1" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding WakeWordThreshold}" />
                        <TextBlock Style="{StaticResource Label}" Text="{Binding EndPauseSeconds, StringFormat='End Pause: {0:0.0}s'}" />
                        <Slider Minimum="1" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding EndPauseSeconds}" />
                        <TextBlock Style="{StaticResource Label}" Text="{Binding ListeningTimeoutSeconds, StringFormat='Listening Timeout: {0:0}s'}" />
                        <Slider Minimum="5" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ListeningTimeoutSeconds}" />
                        <Button Content="일반 설정 저장" Command="{Binding SaveGeneralCommand}" HorizontalAlignment="Left" Margin="0,8,0,16" />

                        <TextBlock Text="LLM 컨텍스트" FontSize="16" FontWeight="Bold" />
                        <CheckBox Content="대화 컨텍스트 사용" IsChecked="{Binding ContextEnabled}" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource Label}" Text="{Binding ContextWindowSize, StringFormat='Context Window: {0} messages'}" />
                        <Slider Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ContextWindowSize}" />
                        <TextBlock Text="{Binding EstimatedTokens}" Foreground="Gray" />
                        <Button Content="컨텍스트 설정 저장" Command="{Binding SaveContextCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </TabItem>

        <!-- 히스토리 -->
        <TabItem Header="History" DataContext="{Binding History}">
            <DockPanel Margin="10">
                <Button DockPanel.Dock="Top" Content="새로고침" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" Margin="0,0,0,10" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="Gray" />
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="160" />
                        <DataGridTextColumn Header="질문" Binding="{Binding Query}" Width="*" />
                        <DataGridTextColumn Header="응답" Binding="{Binding Response}" Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>

        <!-- 로그 -->
        <TabItem Header="Logs" DataContext="{Binding Logs}">
            <DockPanel Margin="10">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <ComboBox ItemsSource="{Binding Services}" SelectedItem="{Binding ServiceFilter}" Width="130" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding Levels}" SelectedItem="{Binding LevelFilter}" Width="110" Margin="0,0,6,0" />
                    <Button Content="조회" Command="{Binding RefreshCommand}" />
                    <ToggleButton Content="Live" IsChecked="{Binding IsLive, Mode=OneWay}" Command="{Binding ToggleLiveCommand}" Padding="10,4" Margin="0,0,6,0" />
                    <Button Content="지우기" Command="{Binding ClearCommand}" />
                    <Button Content="통계 새로고침" Command="{Binding RefreshStatsCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding Stats}" Margin="0,0,0,6" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Foreground="Gray" />
                <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" FontFamily="Consolas">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="100" />
                        <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="70" />
                        <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="100" />
                        <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="150" />
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
