<Window x:Class="EdgeVoice.Agent.Desktop.Tray.VoiceOrbWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tray="clr-namespace:EdgeVoice.Agent.Desktop.Tray"
        Width="132" Height="150"
        SystemDecorations="None" TransparencyLevelHint="Transparent" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" CanResize="False" ShowActivated="False"
        ToolTip.Tip="왼쪽 클릭: 말하기 시작/중지 · 오른쪽 클릭: EdgeVoice 창 열기 · 드래그: 이동">
    <StackPanel>
        <Border Width="120" Height="120" CornerRadius="60" Background="#B318181B">
            <tray:RippleView x:Name="Ripple" Width="120" Height="120" />
        </Border>
        <TextBlock x:Name="StateLabel" HorizontalAlignment="Center" Foreground="#E4E4E7"
                   FontSize="12" Margin="0,4,0,0" Text="대기" />
    </StackPanel>
</Window>
