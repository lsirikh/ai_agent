<Window x:Class="EdgeVoice.Agent.Desktop.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        Title="EdgeVoice Agent" Icon="/Assets/edgevoice.ico" Width="1200" Height="800" MinWidth="900" MinHeight="600"
        Background="{DynamicResource OfficeCanvasBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Malgun Gothic, Noto Sans KR, sans-serif">
    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Margin" Value="0,8,0,3" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="Foreground" Value="{DynamicResource OfficeSubtleTextBrush}" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,0" />
        </Style>
        <Style Selector="TextBlock.cardTitle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.kpiLabel">
            <Setter Property="Foreground" Value="{DynamicResource OfficeSubtleTextBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.kpiValue">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- Office 카드: 회색 캔버스 위 흰(다크: 짙은 회색) 카드, 8px 모서리, 얕은 그림자 -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource OfficeCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OfficeStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="BoxShadow" Value="0 1 3 0 #22000000" />
        </Style>

        <!-- 왼쪽 탐색 창(Office Backstage / Outlook 내비게이션 형태) -->
        <Style Selector="TabControl.nav">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource OfficeNavBrush}" />
        </Style>
        <Style Selector="TabControl.nav > TabItem">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="TabControl.nav > TabItem:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource OfficeHoverBrush}" />
        </Style>
        <Style Selector="TabControl.nav > TabItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource OfficeSelectedBrush}" />
        </Style>
        <Style Selector="TabControl.nav > TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource OfficeAccentTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.page">
            <Setter Property="Background" Value="{DynamicResource OfficeCanvasBrush}" />
            <Setter Property="Padding" Value="24,20,12,12" />
        </Style>

        <!-- 빈 상태 안내 문구 (모든 페이지 공통) -->
        <Style Selector="TextBlock.empty">
            <Setter Property="Foreground" Value="{DynamicResource OfficeSubtleTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <!-- 도움말(필드 아래 작은 설명) -->
        <Style Selector="TextBlock.help">
            <Setter Property="Foreground" Value="{DynamicResource OfficeSubtleTextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <!-- "다시 시작 후 적용" 배지 -->
        <Style Selector="Border.badge">
            <Setter Property="Background" Value="{DynamicResource OfficeWarningBackgroundBrush}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
        <Style Selector="Border.badge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource OfficeWarningTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- 표 머리글: 모든 표가 같은 굵기·색 -->
        <Style Selector="DataGridColumnHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OfficeSubtleTextBrush}" />
        </Style>
        <!-- 로그 레벨 색 -->
        <Style Selector="TextBlock.lvError">
            <Setter Property="Foreground" Value="{DynamicResource OfficeErrorTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.lvWarning">
            <Setter Property="Foreground" Value="{DynamicResource OfficeWarningTextBrush}" />
        </Style>
        <Style Selector="TextBlock.lvDebug">
            <Setter Property="Foreground" Value="{DynamicResource OfficeSubtleTextBrush}" />
        </Style>

        <!-- 상단 앱 바 버튼 -->
        <Style Selector="Button.appBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource OfficeHeaderForegroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="Button.appBar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="{DynamicResource OfficeHeaderForegroundBrush}" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- 앱 바 (Microsoft 365 머리글) -->
        <Border DockPanel.Dock="Top" Height="48" Background="{DynamicResource OfficeHeaderBrush}" Padding="16,0,8,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                    <Border Width="24" Height="24" CornerRadius="5" Background="#FFFFFF">
                        <TextBlock Text="EV" FontSize="11" FontWeight="Bold" Foreground="#0F6CBD"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="EdgeVoice Agent" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource OfficeHeaderForegroundBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Text="{Binding Dashboard.SystemStatus}" VerticalAlignment="Center"
                               Foreground="{DynamicResource OfficeHeaderForegroundBrush}" Opacity="0.85" />
                    <Button x:Name="ThemeButton" Classes="appBar" Content="{Binding ThemeLabel}"
                            Command="{Binding ToggleThemeCommand}" ToolTip.Tip="라이트/다크 테마 전환" />
                </StackPanel>
                <Panel />
            </DockPanel>
        </Border>

        <TabControl x:Name="Nav" Classes="nav" TabStripPlacement="Left">
            <!-- 대시보드 -->
            <TabItem Header="Dashboard">
                <Border Classes="page" DataContext="{Binding Dashboard}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Classes="accent" Content="새로고침" Command="{Binding RefreshCommand}"
                                    VerticalAlignment="Top" Margin="0,0,12,0" />
                            <TextBlock Text="대시보드" Classes="title" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="status" />
                        <ScrollViewer>
                            <Grid ColumnDefinitions="2*,*" RowDefinitions="Auto,280,280,260">
                                <UniformGrid Grid.ColumnSpan="2" Columns="4">
                                    <Border Classes="card">
                                        <StackPanel><TextBlock Text="Orchestrator" Classes="kpiLabel" /><TextBlock Text="{Binding OrchestratorState}" Classes="kpiValue" /></StackPanel>
                                    </Border>
                                    <Border Classes="card">
                                        <StackPanel><TextBlock Text="GPU" Classes="kpiLabel" /><TextBlock Text="{Binding Gpu}" Classes="kpiValue" /></StackPanel>
                                    </Border>
                                    <Border Classes="card">
                                        <StackPanel><TextBlock Text="Active Sessions" Classes="kpiLabel" /><TextBlock Text="{Binding Sessions}" Classes="kpiValue" /></StackPanel>
                                    </Border>
                                    <Border Classes="card">
                                        <StackPanel><TextBlock Text="Documents" Classes="kpiLabel" /><TextBlock Text="{Binding Documents}" Classes="kpiValue" /></StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Grid.Row="1" Classes="card">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="GPU 사용률 추이 (%)" Classes="cardTitle" />
                                        <lvc:CartesianChart x:Name="GpuChart" Series="{Binding GpuSeries}"
                                                            XAxes="{Binding GpuXAxes}" YAxes="{Binding GpuYAxes}" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="1" Grid.Column="1" Classes="card">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="서비스 상태" Classes="cardTitle" />
                                        <lvc:PieChart x:Name="ServiceChart" Series="{Binding ServiceHealthSeries}"
                                                      LegendPosition="Bottom" LegendTextPaint="{Binding LegendTextPaint}" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="2" Classes="card">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="로그 레벨별 건수" Classes="cardTitle" />
                                        <lvc:CartesianChart x:Name="LogLevelChart" Series="{Binding LogLevelSeries}"
                                                            XAxes="{Binding LogLevelXAxes}" YAxes="{Binding LogLevelYAxes}" />
                                    </DockPanel>
                                </Border>
                                <Border Grid.Row="2" Grid.Column="1" Classes="card">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="서비스별 로그 건수" Classes="cardTitle" />
                                        <lvc:CartesianChart x:Name="LogServiceChart" Series="{Binding LogServiceSeries}"
                                                            XAxes="{Binding LogServiceXAxes}" YAxes="{Binding LogServiceYAxes}" />
                                    </DockPanel>
                                </Border>

                                <Border Grid.Row="3" Grid.ColumnSpan="2" Classes="card">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Top" Text="서비스" Classes="cardTitle" />
                                        <Panel>
                                            <DataGrid ItemsSource="{Binding Services}" AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Service" Binding="{Binding Name}" Width="200" />
                                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <TextBlock x:Name="DashboardEmpty" Classes="empty" IsVisible="{Binding !Services.Count}"
                                                       Text="서비스 상태가 아직 없습니다. 백엔드에 연결되면 자동으로 채워집니다." />
                                        </Panel>
                                    </DockPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- 채팅 -->
            <TabItem Header="Chat">
                <Border x:Name="ChatPage" Classes="page" DataContext="{Binding Chat}" DragDrop.AllowDrop="True">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button x:Name="NewConversation" DockPanel.Dock="Right" Content="새 대화" Command="{Binding NewConversationCommand}"
                                    VerticalAlignment="Top" Margin="0,0,12,0" ToolTip.Tip="새 세션을 시작합니다(이전 대화는 History 에 남습니다)" />
                            <TextBlock Text="채팅" Classes="title" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="status" />
                        <Border DockPanel.Dock="Bottom" Classes="card" Padding="8" Margin="0,0,12,0">
                            <DockPanel>
                                <ToggleButton x:Name="MuteToggle" DockPanel.Dock="Left" Width="44" Margin="0,0,6,0" FontSize="16" Content="🔇"
                                              IsChecked="{Binding IsMuted, Mode=OneWay}" Command="{Binding ToggleMuteCommand}"
                                              ToolTip.Tip="상시 마이크 음소거/해제 (켜 두면 'Hey Jarvis' 로 말을 걸 수 있습니다)" />
                                <Button x:Name="AttachImage" DockPanel.Dock="Left" Width="44" Margin="0,0,6,0" FontSize="16" Content="📎"
                                        Command="{Binding AttachFileCommand}"
                                        ToolTip.Tip="이미지 첨부 — 화면 캡처(Win+Shift+S)를 입력창에 Ctrl+V 로 붙여 넣어도 됩니다" />
                                <CheckBox DockPanel.Dock="Right" Content="RAG" IsChecked="{Binding UseRag}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                <Button DockPanel.Dock="Right" Classes="accent" Content="전송" Command="{Binding SendCommand}" IsDefault="True" Margin="6,0,0,0" />
                                <TextBox x:Name="ChatInput" Text="{Binding Input}" VerticalContentAlignment="Center"
                                         Watermark="메시지를 입력하세요 (이미지는 📎 또는 Ctrl+V)" />
                            </DockPanel>
                        </Border>
                        <ItemsControl x:Name="ChatAttachments" DockPanel.Dock="Bottom" ItemsSource="{Binding Attachments}"
                                      IsVisible="{Binding HasAttachments}" Margin="0,0,12,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="card" Padding="4">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Image Source="{Binding Preview}" Height="56" MaxWidth="120" Stretch="Uniform" />
                                            <Button Content="✕" Padding="6,2" VerticalAlignment="Top" ToolTip.Tip="{Binding Name}"
                                                    Command="{Binding $parent[ItemsControl].DataContext.RemoveAttachmentCommand}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Classes="card">
                            <Panel>
                                <TextBlock x:Name="ChatEmpty" Classes="empty" IsVisible="{Binding !Messages.Count}"
                                           Text="Hey Jarvis 라고 부르거나 메시지를 입력하세요" />
                                <ListBox x:Name="ChatMessages" ItemsSource="{Binding Messages}" Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Foreground="{DynamicResource OfficeAccentTextBrush}" />
                                                    <TextBlock Text="🎙 음성" IsVisible="{Binding IsVoice}" Opacity="0.7" ToolTip.Tip="음성으로 나눈 대화" />
                                                </StackPanel>
                                                <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Panel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- 지식 베이스 -->
            <TabItem Header="Knowledge">
                <Border Classes="page" DataContext="{Binding Knowledge}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="지식 베이스" Classes="title" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                            <Button Classes="accent" Content="문서 업로드..." Command="{Binding UploadCommand}" />
                            <Button Content="새로고침" Command="{Binding RefreshCommand}" />
                            <TextBlock Text="{Binding SupportedFormats}" Classes="help" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="status" TextWrapping="Wrap" />
                        <Border Classes="card">
                            <Panel>
                                <DataGrid ItemsSource="{Binding Documents}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="파일" Binding="{Binding Filename}" Width="*" />
                                        <DataGridTextColumn Header="조각 수 | 업로드 시각" Binding="{Binding Meta}" Width="260" />
                                        <DataGridTemplateColumn Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="삭제" CommandParameter="{Binding}"
                                                            Command="{Binding $parent[DataGrid].DataContext.DeleteCommand}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="KnowledgeEmpty" Classes="empty" IsVisible="{Binding !Documents.Count}"
                                           Text="등록된 문서가 없습니다. '문서 업로드...' 로 추가하면 채팅의 RAG 답변에 쓰입니다." />
                            </Panel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- 설정 -->
            <TabItem Header="Settings">
                <Border Classes="page" DataContext="{Binding Settings}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="설정" Classes="title" />
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="status" />
                        <!-- 콤보박스 선택값 = 실행 중인 서비스 값. 저장값과 다르면 배지 -->
                        <Border x:Name="PendingBadge" DockPanel.Dock="Top" Classes="badge" IsVisible="{Binding HasPendingRestart}">
                            <TextBlock Text="{Binding PendingRestart, StringFormat='다시 시작 후 적용: {0}'}" />
                        </Border>
                        <ScrollViewer>
                            <Grid ColumnDefinitions="*,*" VerticalAlignment="Top">
                                <StackPanel>
                                    <Border Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="음성 인식" Classes="cardTitle" />
                                            <TextBlock Text="음성 인식 모델 (STT)" Classes="label" />
                                            <ComboBox x:Name="SttModelCombo" ItemsSource="{Binding SttModels}" DisplayMemberBinding="{Binding Label}"
                                                      SelectedValueBinding="{Binding Id}" SelectedValue="{Binding SttModel}" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="호출어 (Wake Word)" Classes="label" />
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="호출어 바로 바꾸기" Command="{Binding RegisterWakeWordCommand}" Margin="6,0,0,0"
                                                        ToolTip.Tip="선택한 호출어를 웨이크워드 서비스에 바로 적용합니다" />
                                                <ComboBox x:Name="WakeWordCombo" ItemsSource="{Binding WakeWords}" SelectedItem="{Binding WakeWord}" HorizontalAlignment="Stretch" />
                                            </DockPanel>
                                            <TextBlock Text="이 말을 들으면 듣기 시작합니다. '호출어 바로 바꾸기' 는 다른 일반 설정을 저장하지 않고 호출어만 바꿉니다." Classes="help" />
                                            <TextBlock Classes="label" Text="{Binding WakeWordThreshold, StringFormat='호출어 민감도 (임계값): {0:0.00}'}" />
                                            <Slider Minimum="0.1" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding WakeWordThreshold}" />
                                            <TextBlock Text="낮을수록 잘 반응하고 잘못 깨어날 수도 있습니다. 웨이크워드 서비스가 지금 쓰는 값입니다." Classes="help" />
                                            <TextBlock Classes="label" Text="{Binding EndPauseSeconds, StringFormat='말 끝 판단 무음: {0:0.0}초'}" />
                                            <Slider Minimum="1" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding EndPauseSeconds}" />
                                            <TextBlock Classes="label" Text="{Binding ListeningTimeoutSeconds, StringFormat='듣기 제한 시간: {0:0}초'}" />
                                            <Slider Minimum="5" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ListeningTimeoutSeconds}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="답변 음성" Classes="cardTitle" />
                                            <TextBlock Text="음성 엔진 (TTS)" Classes="label" />
                                            <ComboBox x:Name="TtsEngineCombo" ItemsSource="{Binding TtsEngines}" DisplayMemberBinding="{Binding Label}"
                                                      SelectedValueBinding="{Binding Id}" SelectedValue="{Binding TtsEngine}" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="음성" Classes="label" />
                                            <ComboBox x:Name="TtsVoiceCombo" ItemsSource="{Binding TtsVoices}" SelectedItem="{Binding TtsVoice}" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="엔진마다 쓸 수 있는 음성이 다릅니다 (MeloTTS 는 KR 하나)." Classes="help" />
                                            <TextBlock Classes="label" Text="{Binding VoiceSpeed, StringFormat='말하기 속도: {0:0.0}x'}" />
                                            <Slider Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding VoiceSpeed}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="MCP 서버" Classes="cardTitle" />
                                            <TextBlock Text="체크하면 연결하고 끄면 연결을 닫습니다 (채팅은 바로, 음성은 다음 질문부터). 목록에서 고르면 아래 칸에 채워집니다." Classes="help" TextWrapping="Wrap" />
                                            <ListBox x:Name="McpServerList" ItemsSource="{Binding McpServers}" SelectedItem="{Binding SelectedMcpServer}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" />
                                                            <TextBlock Text="{Binding Detail}" Classes="help" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="이름" Classes="label" />
                                            <TextBox Text="{Binding McpName}" Watermark="예: browser" />
                                            <TextBlock Text="주소 (streamable HTTP)" Classes="label" />
                                            <TextBox Text="{Binding McpUrl}" Watermark="예: http://host.docker.internal:8931/mcp" />
                                            <TextBlock Text="또는 실행 명령 (stdio) · 인자" Classes="label" />
                                            <TextBox Text="{Binding McpCommand}" Watermark="예: python" />
                                            <TextBox Text="{Binding McpArgs}" Watermark="인자 (쉼표로 구분)" />
                                            <TextBlock Text="허용 도구 (이 목록의 도구만 LLM 에 보입니다)" Classes="label" />
                                            <TextBox Text="{Binding McpAllowedTools}" Watermark="쉼표로 구분" />
                                            <TextBlock Text="항상 확인할 도구 · 확인 없이 실행할 도구" Classes="label" />
                                            <TextBox Text="{Binding McpAlwaysConfirm}" Watermark="항상 확인 (쉼표로 구분)" />
                                            <TextBox Text="{Binding McpNoConfirm}" Watermark="확인 없이 (쉼표로 구분)" />
                                            <CheckBox Content="신뢰하는 서버 (읽기 전용 도구는 묻지 않고 실행)" IsChecked="{Binding McpTrusted}" />
                                            <TextBlock Classes="label" Text="{Binding McpTimeout, StringFormat='시간 제한: {0:0}초'}" />
                                            <Slider Minimum="5" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding McpTimeout}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Classes="accent" Content="추가" Command="{Binding AddMcpServerCommand}" />
                                                <Button Content="고른 서버 저장" Command="{Binding UpdateMcpServerCommand}" />
                                                <Button Content="삭제" Command="{Binding DeleteMcpServerCommand}" />
                                                <Button Content="연결 상태 새로고침" Command="{Binding RefreshMcpCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Border Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="언어 모델" Classes="cardTitle" />
                                            <TextBlock Text="LLM 모델 (받아 둔 모델만)" Classes="label" />
                                            <ComboBox x:Name="LlmModelCombo" ItemsSource="{Binding LlmModels}" DisplayMemberBinding="{Binding Label}"
                                                      SelectedValueBinding="{Binding Id}" SelectedValue="{Binding LlmModel}" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="모델을 바꾸면 vLLM 을 다시 만들어야 적용됩니다 (docker compose up -d llm)." Classes="help" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Classes="accent" Content="모델 적용" Command="{Binding ApplyModelsCommand}"
                                                        ToolTip.Tip="음성 인식·답변 음성·언어 모델 선택을 저장합니다" />
                                                <Button Content="LLM 다시 만들기" Command="{Binding RestartLlmCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="대화 (컨텍스트)" Classes="cardTitle" />
                                            <CheckBox Content="이전 대화를 기억해 답하기" IsChecked="{Binding ContextEnabled}" />
                                            <TextBlock Classes="label" Text="{Binding ContextWindowSize, StringFormat='기억할 메시지 수: {0}'}" />
                                            <Slider Minimum="5" Maximum="50" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ContextWindowSize}" />
                                            <TextBlock Text="{Binding EstimatedTokens}" Classes="help" />
                                            <Button Classes="accent" Content="컨텍스트 설정 저장" Command="{Binding SaveContextCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="도구 (인터넷 검색)" Classes="cardTitle" />
                                            <CheckBox Content="인터넷 검색·웹 페이지 읽기 허용" IsChecked="{Binding InternetToolsEnabled}" />
                                            <TextBlock Text="{Binding AvailableTools}" Classes="help" />
                                            <Button Classes="accent" Content="도구 설정 저장" Command="{Binding SaveToolsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="지역 및 시간" Classes="cardTitle" />
                                            <CheckBox x:Name="FollowPcTimeZone" Content="PC 시간대 따르기 (시작할 때 자동으로 맞춤)" IsChecked="{Binding FollowPcTimeZone}" />
                                            <TextBlock Text="시간대" Classes="label" />
                                            <ComboBox x:Name="TimeZoneCombo" ItemsSource="{Binding TimeZones}" SelectedItem="{Binding TimeZone}"
                                                      IsEnabled="{Binding !FollowPcTimeZone}" HorizontalAlignment="Stretch" />
                                            <TextBlock Text="{Binding TimeComparison}" Classes="help" TextWrapping="Wrap" />
                                            <TextBlock Text="날씨 기준 지역" Classes="label" />
                                            <TextBox x:Name="LocationBox" Text="{Binding Location}" Watermark="예: 서울, 부산, 제주" />
                                            <CheckBox Content="날씨 알려 주기 (인터넷 도구가 켜져 있을 때, Open-Meteo)" IsChecked="{Binding WeatherEnabled}" />
                                            <Button Classes="accent" Content="지역·시간 설정 저장" Command="{Binding SaveToolsCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="일반" Classes="cardTitle" />
                                            <TextBlock Text="언어" Classes="label" />
                                            <ComboBox x:Name="LanguageCombo" ItemsSource="{Binding Languages}" DisplayMemberBinding="{Binding Label}"
                                                      SelectedValueBinding="{Binding Id}" SelectedValue="{Binding Language}" HorizontalAlignment="Stretch" />
                                            <Button Classes="accent" Content="일반 설정 저장" Command="{Binding SaveGeneralCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                            <TextBlock Text="호출어·민감도·무음·제한 시간·말하기 속도·언어를 저장하고 서비스에 바로 반영합니다." Classes="help" />
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="card">
                                        <StackPanel>
                                            <TextBlock Text="스킬" Classes="cardTitle" />
                                            <TextBlock Text="내장 스킬 (LLM 도구) — 끄면 음성·채팅 모두 쓰지 않습니다." Classes="help" TextWrapping="Wrap" />
                                            <ListBox x:Name="BuiltinSkillList" ItemsSource="{Binding BuiltinSkills}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" />
                                                            <TextBlock Text="{Binding Detail}" Classes="help" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="프롬프트 스킬 — 켜면 지시문이 시스템 프롬프트에 붙습니다." Classes="help" TextWrapping="Wrap" />
                                            <ListBox x:Name="PromptSkillList" ItemsSource="{Binding PromptSkills}" SelectedItem="{Binding SelectedPromptSkill}">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" />
                                                            <TextBlock Text="{Binding Detail}" Classes="help" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                            <TextBlock Text="이름 · 설명" Classes="label" />
                                            <TextBox Text="{Binding SkillName}" Watermark="예: 존댓말" />
                                            <TextBox Text="{Binding SkillDescription}" Watermark="설명 (화면에만 보임)" />
                                            <TextBlock Text="지시문" Classes="label" />
                                            <TextBox Text="{Binding SkillInstructions}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Watermark="예: 항상 존댓말로 답한다." />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Classes="accent" Content="추가" Command="{Binding AddSkillCommand}" />
                                                <Button Content="고른 스킬 저장" Command="{Binding UpdateSkillCommand}" />
                                                <Button Content="삭제" Command="{Binding DeleteSkillCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- 히스토리 -->
            <TabItem Header="History">
                <Border Classes="page" DataContext="{Binding History}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button DockPanel.Dock="Right" Classes="accent" Content="새로고침" Command="{Binding RefreshCommand}"
                                    VerticalAlignment="Top" Margin="0,0,12,0" />
                            <TextBlock Text="히스토리" Classes="title" />
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="status" />
                        <Border Classes="card">
                            <Panel>
                                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="시간" Binding="{Binding Time}" Width="160" />
                                        <DataGridTextColumn Header="질문" Binding="{Binding Query}" Width="*" />
                                        <DataGridTextColumn Header="응답" Binding="{Binding Response}" Width="2*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="HistoryEmpty" Classes="empty" IsVisible="{Binding !Items.Count}"
                                           Text="아직 대화 기록이 없습니다. 채팅이나 음성(Hey Jarvis)으로 나눈 대화가 여기에 쌓입니다." />
                            </Panel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>

            <!-- 로그 -->
            <TabItem Header="Logs">
                <Border Classes="page" DataContext="{Binding Logs}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="로그" Classes="title" />
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                            <ComboBox x:Name="LogServiceCombo" ItemsSource="{Binding Services}" DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}" SelectedValue="{Binding ServiceFilter}" Width="150" Margin="0,0,6,0" />
                            <ComboBox x:Name="LogLevelCombo" ItemsSource="{Binding Levels}" DisplayMemberBinding="{Binding Label}"
                                      SelectedValueBinding="{Binding Id}" SelectedValue="{Binding LevelFilter}" Width="170" Margin="0,0,6,0"
                                      ToolTip.Tip="기본 'INFO 이상' 은 VAD 확률 같은 고빈도 DEBUG 를 숨깁니다. 모두 보려면 '전체(DEBUG 포함)'" />
                            <Button Classes="accent" Content="조회" Command="{Binding RefreshCommand}" />
                            <ToggleButton Content="Live" IsChecked="{Binding IsLive, Mode=OneWay}" Command="{Binding ToggleLiveCommand}" Padding="12,5" Margin="0,0,6,0" />
                            <Button Content="지우기" Command="{Binding ClearCommand}" />
                            <Button Content="통계 새로고침" Command="{Binding RefreshStatsCommand}" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding Stats}" Classes="kpiLabel" Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Classes="status" />
                        <Border Classes="card">
                            <Panel>
                                <DataGrid x:Name="LogGrid" ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas, DejaVu Sans Mono, monospace">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="150" />
                                        <DataGridTemplateColumn Header="Level" Width="95">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Level}" VerticalAlignment="Center" Margin="12,0,0,0"
                                                               Classes.lvError="{Binding IsError}" Classes.lvWarning="{Binding IsWarning}" Classes.lvDebug="{Binding IsDebug}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="160" />
                                        <DataGridTextColumn Header="Stage" Binding="{Binding Stage}" Width="210" />
                                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="105" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="LogsEmpty" Classes="empty" IsVisible="{Binding !Logs.Count}"
                                           Text="표시할 로그가 없습니다. 필터를 '전체' 로 바꾸거나 Live 를 켜 두세요." />
                            </Panel>
                        </Border>
                    </DockPanel>
                </Border>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
