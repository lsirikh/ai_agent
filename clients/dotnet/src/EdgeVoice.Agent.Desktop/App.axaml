<Application x:Class="EdgeVoice.Agent.Desktop.App"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             RequestedThemeVariant="Default">
    <!-- Microsoft 365(Office, Fluent 2) 디자인: 브랜드 파랑 강조색, 회색 캔버스 위 흰 카드, 라이트/다크 테마 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="OfficeHeaderBrush" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="OfficeHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="OfficeCanvasBrush" Color="#F5F5F5" />
                    <SolidColorBrush x:Key="OfficeNavBrush" Color="#FAFAFA" />
                    <SolidColorBrush x:Key="OfficeCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="OfficeStrokeBrush" Color="#E0E0E0" />
                    <SolidColorBrush x:Key="OfficeSubtleTextBrush" Color="#616161" />
                    <SolidColorBrush x:Key="OfficeAccentTextBrush" Color="#0F6CBD" />
                    <SolidColorBrush x:Key="OfficeHoverBrush" Color="#EBEBEB" />
                    <SolidColorBrush x:Key="OfficeSelectedBrush" Color="#EBF3FC" />
                    <SolidColorBrush x:Key="OfficeErrorTextBrush" Color="#B10E1C" />
                    <SolidColorBrush x:Key="OfficeWarningTextBrush" Color="#835B00" />
                    <SolidColorBrush x:Key="OfficeWarningBackgroundBrush" Color="#FFF4CE" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="OfficeHeaderBrush" Color="#292929" />
                    <SolidColorBrush x:Key="OfficeHeaderForegroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="OfficeCanvasBrush" Color="#1F1F1F" />
                    <SolidColorBrush x:Key="OfficeNavBrush" Color="#242424" />
                    <SolidColorBrush x:Key="OfficeCardBrush" Color="#2E2E2E" />
                    <SolidColorBrush x:Key="OfficeStrokeBrush" Color="#3D3D3D" />
                    <SolidColorBrush x:Key="OfficeSubtleTextBrush" Color="#ADADAD" />
                    <!-- 선택된 탐색 항목(#0C3B5E) 위에서도 대비 4.5:1 이상 -->
                    <SolidColorBrush x:Key="OfficeAccentTextBrush" Color="#73B4F7" />
                    <SolidColorBrush x:Key="OfficeHoverBrush" Color="#333333" />
                    <SolidColorBrush x:Key="OfficeSelectedBrush" Color="#0C3B5E" />
                    <SolidColorBrush x:Key="OfficeErrorTextBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="OfficeWarningTextBrush" Color="#F8D86A" />
                    <SolidColorBrush x:Key="OfficeWarningBackgroundBrush" Color="#3D2F00" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#0F6CBD" RegionColor="#FFFFFF" />
                <ColorPaletteResources x:Key="Dark" Accent="#479EF5" RegionColor="#292929" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    </Application.Styles>
</Application>
